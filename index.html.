<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#07152e"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="מרדף Wi-Fi">
<title>מרדף נקודות Wi-Fi | בזק</title>
<style>
:root{font-family:Arial,'Segoe UI',sans-serif;color:#eaf4ff;background:#07152e}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 0%,#174f93 0%,#0b234b 42%,#061126 100%)}.wrap{max-width:1250px;margin:auto;padding:24px 20px 45px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.brand{font-size:30px;font-weight:900;color:white}.brand span{color:#55c8ff}.tag{padding:9px 16px;border:1px solid #427bb4;border-radius:100px;background:#ffffff12;color:#d6ebff}h1{text-align:center;font-size:clamp(35px,5vw,64px);margin:20px 0 4px;color:#ffdc52;text-shadow:0 3px 18px #e9a62055}.sub{text-align:center;color:#d5e7ff;font-size:20px;margin:0 0 27px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}.stat,.team,.ranking,.control{background:linear-gradient(155deg,#133566,#0b2046);border:1px solid #2a6199;border-radius:22px;box-shadow:0 10px 30px #0004}.stat{text-align:center;padding:18px}.stat small{display:block;color:#a9c7e7;margin-bottom:6px}.stat strong{font-size:32px;color:white}.teams{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.team{padding:19px 16px;position:relative;overflow:hidden;border-top:5px solid var(--c)}.team h2{font-size:23px;margin:0 0 14px}.pig{font-size:70px;text-align:center;filter:drop-shadow(0 7px 8px #0007);transition:transform .25s}.pig.pop{animation:pop .55s ease}@keyframes pop{0%{transform:scale(1)}45%{transform:scale(1.25) rotate(-7deg)}100%{transform:scale(1)}}.money{text-align:center;font-size:39px;font-weight:900;color:#ffdc52;margin:5px 0}.points{text-align:center;color:#bcd7f3;font-size:14px;margin-bottom:18px}.field{display:flex;gap:8px}.field input{width:100%;min-width:0;border:1px solid #4a79a9;border-radius:11px;background:#061733;color:white;font-size:19px;padding:12px;text-align:center}.field button,.addone,.btn{border:0;border-radius:11px;background:var(--c);color:#07152e;font-weight:900;cursor:pointer;padding:12px;font-size:16px}.addone{display:block;width:100%;margin-top:9px;background:#ffffff18;color:white;border:1px solid #ffffff44}.field button:hover,.addone:hover,.btn:hover{filter:brightness(1.16)}.lower{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:20px}.ranking,.control{padding:21px}.ranking h2,.control h2{margin:0 0 17px}.rank{display:flex;align-items:center;justify-content:space-between;padding:13px 15px;background:#ffffff0b;border-radius:12px;margin-bottom:9px;border-right:5px solid var(--c)}.rank b{font-size:18px}.rank strong{color:#ffdb56;font-size:20px}.control p{color:#b9d3ee;line-height:1.6}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{background:#1c72bf;color:white}.danger{background:#802d42}.notice{font-size:13px;color:#adc8e7;margin-top:14px;line-height:1.7}.bar{height:9px;border-radius:20px;background:#07152e;overflow:hidden;margin-top:12px}.fill{height:100%;width:0;background:linear-gradient(90deg,#3ec8ff,#ffdc52);transition:width .4s}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#e4f5ff;color:#09244b;padding:12px 22px;border-radius:13px;box-shadow:0 12px 30px #0008;display:none;z-index:2}.muted{color:#a9c7e7}@media(max-width:900px){.teams{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.wrap{padding:15px 12px}.teams,.lower{grid-template-columns:1fr}.stats{gap:7px}.stat{padding:12px 5px}.stat strong{font-size:23px}.stat small{font-size:12px}.team{padding:15px}.pig{font-size:60px}}
@supports(padding:max(0px)){.wrap{padding-bottom:max(45px,env(safe-area-inset-bottom))}}button,input{touch-action:manipulation}button{min-height:44px;-webkit-tap-highlight-color:transparent}input{font-size:16px}@media(max-width:580px){.brand{font-size:23px}.tag{font-size:12px}h1{font-size:32px}.sub{font-size:16px}.stats{grid-template-columns:repeat(2,1fr)}.stats .stat:last-child{grid-column:1/-1}.teams{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.team{padding:12px 9px;border-radius:15px}.team h2{font-size:16px;min-height:39px}.pig{font-size:44px}.money{font-size:28px}.points{font-size:12px}.field{flex-direction:column}.field button{width:100%}.field input{padding:9px}.lower{grid-template-columns:1fr}.stat strong{font-size:25px}}@media(max-width:360px){.teams{grid-template-columns:1fr}}
</style>
</head>
<body><main class="wrap"><div class="top"><div class="brand">בזק <span>Wi-Fi</span></div><div class="tag">🏁 תחרות המוקדים | רביעי–חמישי</div></div><h1>🏆 מרדף נקודות Wi-Fi</h1><p class="sub">מי המוקד שיגרוף הכי הרבה שקלים?</p><section class="stats"><div class="stat"><small>סך נקודות שנמכרו</small><strong id="total">0</strong></div><div class="stat"><small>שווי המכירות המצטבר</small><strong id="sum">₪0</strong></div><div class="stat"><small>המוקד המוביל</small><strong id="leader" style="font-size:23px">עדיין אין</strong></div></section><section class="teams" id="teams"></section><section class="lower"><div class="ranking"><h2>🥇 דירוג המוקדים</h2><div id="ranking"></div></div><div class="control"><h2>⚙️ ניהול התחרות</h2><p>כל נקודת Wi-Fi שנמכרה מוסיפה <b>₪1</b> לקופה של המוקד. אפשר להוסיף נקודה בודדת או להזין כמות מכירות בבת אחת.</p><div class="actions"><button class="btn" id="undo">↩ ביטול הפעולה האחרונה</button><button class="btn" id="export">⬇ ייצוא נתונים</button><button class="btn" id="backup">💾 גיבוי מלא</button><label class="btn" style="display:inline-flex;align-items:center;cursor:pointer">📂 שחזור גיבוי<input id="restore" type="file" accept="application/json,.json" style="display:none"></label><button class="btn danger" id="reset">🗑 איפוס התחרות</button></div><div class="notice">הנתונים נשמרים אוטומטית בדפדפן ובמכשיר הזה בלבד. מומלץ לבצע גיבוי מלא אחרי כל עדכון חשוב. מחיקת נתוני Safari עלולה למחוק את המכירות. כדי להציג אותם במספר מחשבים בו-זמנית נדרש חיבור למסד נתונים או לשרת משותף.<br>תקציב הפעילות המתוכנן: ₪500. המערכת סופרת מכירות ללא הגבלה; חלוקת התקציב בפועל כפופה לכללי הפעילות.</div><div class="bar"><div class="fill" id="progress"></div></div><div class="muted" id="budget" style="margin-top:8px"></div></div></section></main><div class="toast" id="toast" role="status"></div>
<script>
const config=[{id:'haifa',name:'מוקד חיפה',color:'#29c875',emoji:'🟢'},{id:'jerusalem',name:'מוקד ירושלים',color:'#ffce3f',emoji:'🟡'},{id:'beer',name:'מוקד באר שבע',color:'#ff5764',emoji:'🔴'},{id:'kiryat',name:'מוקד קריית שמונה',color:'#4cafff',emoji:'🔵'}];
const key='bezeq_wifi_race_v1';let state={counts:{},history:[]};try{const saved=JSON.parse(localStorage.getItem(key));if(saved&&typeof saved==='object'){state.counts=saved.counts||{};state.history=Array.isArray(saved.history)?saved.history:[]}}catch(e){};for(const t of config){const n=Number(state.counts[t.id]);state.counts[t.id]=Number.isSafeInteger(n)&&n>=0?n:0}function save(){try{localStorage.setItem(key,JSON.stringify(state))}catch(e){showToast('שמירה מקומית אינה זמינה. מומלץ לפתוח דרך אתר מאובטח')}}const fmt=n=>new Intl.NumberFormat('he-IL').format(n);function showToast(msg){const el=document.getElementById('toast');el.textContent=msg;el.style.display='block';clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>el.style.display='none',2400)}function add(id,n){n=Number(n);if(!Number.isSafeInteger(n)||n<=0||n>1000000){showToast('יש להזין מספר שלם בין 1 ל־1,000,000');return}if(!Number.isSafeInteger(state.counts[id]+n)){showToast('המספר גדול מדי');return}state.counts[id]+=n;state.history.push({id,n});save();render();const pig=document.querySelector('[data-pig="'+id+'"]');pig.classList.remove('pop');void pig.offsetWidth;pig.classList.add('pop');showToast('נוספו '+fmt(n)+' נקודות ל'+config.find(t=>t.id===id).name)}function render(){const total=config.reduce((s,t)=>s+state.counts[t.id],0);document.getElementById('total').textContent=fmt(total);document.getElementById('sum').textContent='₪'+fmt(total);const sorted=[...config].sort((a,b)=>state.counts[b.id]-state.counts[a.id]);document.getElementById('leader').textContent=total===0?'עדיין אין':sorted.length>1&&state.counts[sorted[0].id]===state.counts[sorted[1].id]?'תיקו בצמרת':sorted[0].name;document.getElementById('ranking').innerHTML=sorted.map((t,i)=>`<div class="rank" style="--c:${t.color}"><b>${['🥇','🥈','🥉','4️⃣'][i]} ${t.name}</b><strong>₪${fmt(state.counts[t.id])}</strong></div>`).join('');for(const t of config){document.getElementById('money-'+t.id).textContent='₪'+fmt(state.counts[t.id]);document.getElementById('points-'+t.id).textContent=fmt(state.counts[t.id])+' נקודות Wi-Fi'}document.getElementById('progress').style.width=Math.min(100,total/500*100)+'%';document.getElementById('budget').textContent=fmt(total)+' נקודות מתוך יעד תקציבי של 500 ₪';document.getElementById('undo').disabled=state.history.length===0}
document.getElementById('teams').innerHTML=config.map(t=>`<article class="team" style="--c:${t.color}"><h2>${t.emoji} ${t.name}</h2><div class="pig" data-pig="${t.id}">🛒</div><div class="money" id="money-${t.id}">₪0</div><div class="points" id="points-${t.id}">0 נקודות Wi-Fi</div><div class="field"><input id="input-${t.id}" type="number" inputmode="numeric" min="1" max="1000000" step="1" value="1" aria-label="כמות נקודות להוספה עבור ${t.name}"><button data-add="${t.id}">הוסף</button></div><button class="addone" data-one="${t.id}">+ נקודה אחת</button></article>`).join('');document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{const input=document.getElementById('input-'+b.dataset.add);add(b.dataset.add,input.value)});document.querySelectorAll('[data-one]').forEach(b=>b.onclick=()=>add(b.dataset.one,1));document.querySelectorAll('input').forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter')input.nextElementSibling.click()}));document.getElementById('undo').onclick=()=>{const last=state.history.pop();if(!last)return;state.counts[last.id]=Math.max(0,state.counts[last.id]-last.n);save();render();showToast('הפעולה האחרונה בוטלה')};document.getElementById('reset').onclick=()=>{if(!confirm('לאפס את כל המכירות של ארבעת המוקדים? לא ניתן לשחזר לאחר האיפוס.'))return;for(const t of config)state.counts[t.id]=0;state.history=[];save();render();showToast('התחרות אופסה')};document.getElementById('export').onclick=()=>{const rows=[['מוקד','נקודות Wi-Fi','תקציב בשקלים'],...config.map(t=>[t.name,state.counts[t.id],state.counts[t.id]])];const csv='\ufeff'+rows.map(row=>row.join(',')).join('\r\n');const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='bezeq_wifi_competition.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
function downloadFile(filename,content,type){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),10000)}
document.getElementById('backup').onclick=()=>downloadFile('bezeq-wifi-backup.json',JSON.stringify({version:1,exportedAt:new Date().toISOString(),counts:state.counts,history:state.history},null,2),'application/json');
document.getElementById('restore').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text());if(!data.counts||typeof data.counts!=='object'||!config.every(t=>Number.isSafeInteger(data.counts[t.id])&&data.counts[t.id]>=0))throw Error('invalid');if(!confirm('לשחזר את הגיבוי? הפעולה תחליף את הנתונים הנוכחיים.'))return;state.counts=Object.fromEntries(config.map(t=>[t.id,data.counts[t.id]]));state.history=Array.isArray(data.history)?data.history.filter(x=>config.some(t=>t.id===x.id)&&Number.isSafeInteger(x.n)&&x.n>0):[];save();render();showToast('הגיבוי שוחזר בהצלחה')}catch(err){showToast('קובץ הגיבוי אינו תקין')}finally{e.target.value=''}};
render();
</script></body></html>
